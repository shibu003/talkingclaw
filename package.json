{
  "name": "talkingclaw",
  "version": "0.1.0",
  "description": "アニメ声の彼女キャラ agent クロエと喋りながらコーディングできる CLI",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node src/index.ts",
    "smoke": "node src/smoke.ts",
    "web": "node src/room.ts",
    "setup-voice": "node scripts/setup-voice.mjs",
    "metrics": "node scripts/metrics-report.mjs",
    "cli": "node src/cli.ts",
    "check-ui": "node test/check-ui.mjs && node test/check-nav.mjs && node test/check-git.mjs",
    "setup-stt": "swiftc -O tools/listen.swift -o tools/claw-listen -framework Speech -framework AVFoundation"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shibu003/talkingclaw.git"
  },
  "keywords": [],

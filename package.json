{
  "name": "talkingclaw",
  "version": "0.1.0",
  "description": "複数の coding agent が 1 つの「声の部屋」に同席し、agent ごとに違うアニメ声で喋りながら開発するローカル OSS(API キー不要)",
  "scripts": {
    "test": "npm run check-ui",
    "start": "node src/index.ts",
    "smoke": "node src/smoke.ts",
    "web": "node src/room.ts",
    "setup-voice": "node scripts/setup-voice.mjs",
    "metrics": "node scripts/metrics-report.mjs",
    "cost": "node scripts/cost-report.mjs",
    "split-log": "node scripts/split-transcript.mjs",
    "cli": "node src/cli.ts",
    "check-ui": "node test/check-ui.mjs && node test/check-nav.mjs && node test/check-git.mjs && node test/check-artifacts.mjs && node test/check-convos.mjs",
    "setup-stt": "swiftc -O tools/listen.swift -o tools/claw-listen -framework Speech -framework AVFoundation"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shibu003/talkingclaw.git"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "codex",
    "multi-agent",
    "coding-agent",
    "voice",
    "tts",
    "aivisspeech",
    "voice-chat",
    "local-first"
  ],
  "author": "shibu003",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/shibu003/talkingclaw/issues"
  },
  "homepage": "https://github.com/shibu003/talkingclaw#readme",
  "private": true,
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@ricky0123/vad-web": "^0.0.30"
  }
}

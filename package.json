  "type": "module",
  "bugs": {
    "url": "https://github.com/shibu003/talkingclaw/issues"
  },
  "homepage": "https://github.com/shibu003/talkingclaw#readme",
  "private": true,
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@ricky0123/vad-web": "^0.0.30"
  }
}
